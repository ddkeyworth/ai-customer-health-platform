# Copy this file to .env and fill in real values locally.
# .env is gitignored – never commit real credentials.

DATABASE_URL="postgresql://user:password@host:port/dbname"
ANTHROPIC_API_KEY="sk-ant-..."

# 32-byte random key, base64-encoded - encrypts any workspace's own stored
# Anthropic API key at rest (see Settings). Generate your own, don't reuse
# this placeholder: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY="replace-with-your-own-generated-value"

# No separate env var needed for rate limiting - src/lib/rateLimit.ts uses
# the same DATABASE_URL above (a RateLimitBucket table), not a paid Redis
# service.

# Secures the daily cron job (see vercel.json and src/app/api/cron/run-capabilities)
# so only Vercel's own scheduled invocation can trigger it, not a random public
# request. Vercel automatically sends this as a Bearer token when it calls the
# route, once this env var exists in your Vercel project. Generate your own -
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET="replace-with-your-own-generated-value"

# --- Hosted site or your own copy -------------------------------------------
# Leave SELF_HOSTED unset for the owner's hosted demo: it is a demonstration
# site, signup is closed, the shared demo is locked, and uploads have caps. On
# your own copy, on your own servers, set it to the exact value true: no locks,
# no caps, and signup is open for your first account only.
#
# It is commented out on purpose. If you copy this file into the OWNER'S hosted
# project, an active SELF_HOSTED="true" would switch off the demo lock and the
# caps, and the public demo login could then spend the owner's AI key.
# SELF_HOSTED="true"

# Who may create a workspace. Only the exact values below count; anything else
# (including TRUE or yes) is treated as unset.
#   true   open: anyone who can reach the sign-up page may create a workspace
#   false  closed
#   unset  hosted site: closed. Self-hosted copy: open only until the first
#          account exists, then closed.
# ALLOW_SIGNUP="true"

# How many reverse proxies you run in front of the app (nginx, Cloudflare, ...).
# The visitor's address, used by the sign-up, login and password-reset limits,
# is the X-Forwarded-For entry that many from the right. Default 1. Use 0 to
# ignore the header (every visitor then shares one limit, which is stricter).
# Not used on Vercel, which reports the address itself.
# TRUSTED_PROXY_HOPS="1"

# The demo seed (prisma/seed.ts) creates a login with a publicly known
# password, so it refuses to run unless this is true. Do not set it on a real
# deployment.
# ALLOW_DEMO_SEED="true"
