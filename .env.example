# Copy this file to .env and fill in real values locally.
# .env is gitignored – never commit real credentials.

DATABASE_URL="postgresql://user:password@host:port/dbname"
ANTHROPIC_API_KEY="sk-ant-..."

# 32-byte random key, base64-encoded - encrypts any workspace's own stored
# Anthropic API key at rest (see Settings). Generate your own, don't reuse
# this placeholder: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY="replace-with-your-own-generated-value"

# No separate env var needed for rate limiting - src/lib/rateLimit.ts uses
# the same DATABASE_URL above (a RateLimitBucket table), not a paid Redis
# service.

# Secures the daily cron job (see vercel.json and src/app/api/cron/run-capabilities)
# so only Vercel's own scheduled invocation can trigger it, not a random public
# request. Vercel automatically sends this as a Bearer token when it calls the
# route, once this env var exists in your Vercel project. Generate your own -
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET="replace-with-your-own-generated-value"

# --- Hosted site or your own copy -------------------------------------------
# Leave this unset for the owner's hosted demo (14-day trials, the shared demo
# is locked, signups are capped). On your own copy set it to the exact value
# true: no trial, no locks, no caps.
SELF_HOSTED="true"

# Optional. Set to false once your own account exists so strangers cannot sign
# up on a private copy. Any other value leaves signup open.
# ALLOW_SIGNUP="false"

# The demo seed (prisma/seed.ts) creates a login with a publicly known
# password, so it refuses to run unless this is true. Do not set it on a real
# deployment.
# ALLOW_DEMO_SEED="true"
